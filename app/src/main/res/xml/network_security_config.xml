<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      The config stays permissive for the server the user points the app at: a
      self-hosted RomM is commonly plain HTTP on a LAN, or fronted by a
      certificate signed by a CA the user installed themselves. That address is
      unknown at build time, so it can only be covered by the default. The app
      contacts no fixed domains, so there is no domain-config to pin tighter.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
